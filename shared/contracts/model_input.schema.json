{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego.local/contracts/model_input.schema.json",
  "title": "Safety Companion Router Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "input_id",
    "device_id",
    "timestamp_ms",
    "mode",
    "features",
    "evidence_available"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "input_id": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "type": "string",
      "enum": [
        "personal_safety",
        "child_safety",
        "elder_safety",
        "cycling",
        "test"
      ]
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion",
        "audio",
        "location",
        "network",
        "device",
        "history",
        "user"
      ],
      "properties": {
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activity_label",
            "activity_confidence",
            "impact_score",
            "fall_score",
            "stationary_seconds",
            "device_worn"
          ],
          "properties": {
            "activity_label": {
              "type": "string",
              "enum": [
                "unknown",
                "stationary",
                "walking",
                "running",
                "cycling",
                "vehicle",
                "impact",
                "fall_candidate"
              ]
            },
            "activity_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "impact_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "fall_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "stationary_seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            },
            "device_worn": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "speech_score",
            "distress_score",
            "impact_sound_score",
            "unknown_loud_sound_score",
            "quality_score"
          ],
          "properties": {
            "speech_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "distress_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "impact_sound_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "unknown_loud_sound_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "quality_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fix_valid",
            "speed_mps",
            "outside_safe_zone",
            "dwell_seconds",
            "route_deviation_m",
            "quality_score"
          ],
          "properties": {
            "fix_valid": {
              "type": "boolean"
            },
            "speed_mps": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "outside_safe_zone": {
              "type": "boolean"
            },
            "dwell_seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 604800
            },
            "route_deviation_m": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "quality_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connectivity_score",
            "base_online",
            "upload_available",
            "signal_level",
            "offline_seconds"
          ],
          "properties": {
            "connectivity_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "base_online": {
              "type": "boolean"
            },
            "upload_available": {
              "type": "boolean"
            },
            "signal_level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "offline_seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 604800
            }
          }
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "battery_percent",
            "charging",
            "privacy_mode",
            "camera_available",
            "microphone_available"
          ],
          "properties": {
            "battery_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "charging": {
              "type": "boolean"
            },
            "privacy_mode": {
              "type": "boolean"
            },
            "camera_available": {
              "type": "boolean"
            },
            "microphone_available": {
              "type": "boolean"
            }
          }
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recent_risk_count_5m",
            "last_user_response",
            "seconds_since_last_contact"
          ],
          "properties": {
            "recent_risk_count_5m": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "last_user_response": {
              "type": "string",
              "enum": [
                "none",
                "safe",
                "need_help",
                "no_response",
                "cancel"
              ]
            },
            "seconds_since_last_contact": {
              "type": "number",
              "minimum": 0,
              "maximum": 604800
            }
          }
        },
        "user": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sos_pressed",
            "cancel_pressed"
          ],
          "properties": {
            "sos_pressed": {
              "type": "boolean"
            },
            "cancel_pressed": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "evidence_available": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audio_clip",
        "single_image",
        "fresh_gnss",
        "imu_window"
      ],
      "properties": {
        "audio_clip": {
          "type": "boolean"
        },
        "single_image": {
          "type": "boolean"
        },
        "fresh_gnss": {
          "type": "boolean"
        },
        "imu_window": {
          "type": "boolean"
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
