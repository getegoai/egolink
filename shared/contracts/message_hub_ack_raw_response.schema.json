{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego.local/contracts/message_hub_ack_raw_response.schema.json",
  "title": "Ego Link P0 Raw ACK HTTP Acceptance Result",
  "$comment": "A device may clear a persisted terminal timer ACK only when disposition is an accepted class and accepted_ack_sha256 equals both posted_ack_sha256 and the SHA-256 of the exact raw frame bytes it posted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "raw_frame", "command_ack"],
  "properties": {
    "ok": {"const": true},
    "raw_frame": {"type": "object"},
    "command_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "command_status",
        "posted_ack_sha256",
        "accepted_ack_sha256"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "newly_applied",
            "refresh_applied",
            "idempotent_already_applied",
            "nonterminal_recorded",
            "conflict_ignored",
            "unknown_command_ignored",
            "terminal_ack_ignored"
          ]
        },
        "command_status": {
          "enum": [
            "unknown",
            "pending",
            "in_progress",
            "ok",
            "applied",
            "error",
            "rejected",
            "timeout",
            "mock_only",
            "expired"
          ]
        },
        "posted_ack_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "accepted_ack_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
