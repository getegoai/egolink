{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego.local/contracts/location_state_envelope_v0.schema.json",
  "title": "EgoLink Location Engine v0 source-event envelope",
  "description": "Additive LOC-021 ingress contract. server_receive_time_ms is transport evidence added by the trusted server adapter; it never owns source ordering or freshness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_contract_version",
    "device_id",
    "boot_count",
    "session_id",
    "event_time_ms",
    "event_time_source",
    "event_time_ns",
    "monotonic_clock_domain_id",
    "sequence_id",
    "observation_id",
    "policy_identity",
    "location_state"
  ],
  "properties": {
    "envelope_contract_version": {
      "const": "egolink.location_state_envelope.v0.1"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
    },
    "boot_count": {
      "type": "integer",
      "minimum": 0
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
    },
    "event_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "event_time_source": {
      "type": "string",
      "enum": [
        "timestamp_utc_ns",
        "gnss_source_utc_ns",
        "timestamp_monotonic_ns"
      ]
    },
    "event_time_ns": {
      "type": "integer",
      "minimum": 0
    },
    "monotonic_clock_domain_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 256
    },
    "sequence_id": {
      "type": "integer",
      "minimum": 0
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policy_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "semantic_validation",
        "config_id",
        "config_hash"
      ],
      "properties": {
        "contract_version": {
          "const": "egolink.sensor_policy_config.v0.1"
        },
        "semantic_validation": {
          "const": "egolink.sensor_policy.semantic.v0.1"
        },
        "config_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "location_state": {
      "$ref": "location_engine_v0.schema.json"
    },
    "server_receive_time_ms": {
      "description": "Trusted server-added transport timestamp only; never a device event clock.",
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_time_source": {
            "const": "timestamp_monotonic_ns"
          }
        },
        "required": ["event_time_source"]
      },
      "then": {
        "properties": {
          "monotonic_clock_domain_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "else": {
        "properties": {
          "monotonic_clock_domain_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
