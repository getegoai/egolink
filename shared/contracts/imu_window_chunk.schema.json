{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego.local/contracts/imu_window_chunk.schema.json",
  "title": "EgoLink bounded IMU window chunk v1 normalized wire object",
  "description": "The complete EGLK/1 KV payload after underscore key normalization and scalar typing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "priority",
    "source",
    "source_status",
    "fw_version",
    "test_run_id",
    "seq",
    "transport_type",
    "boot_count",
    "contract_version",
    "window_id",
    "capture_cmd_id",
    "chunk_index",
    "chunk_count",
    "sample_start_index",
    "sample_count",
    "total_sample_count",
    "requested_interval_us",
    "sample_record_bytes",
    "sample_encoding",
    "chunk_crc32",
    "samples_b64"
  ],
  "properties": {
    "event_type": { "const": "imu_window_chunk" },
    "priority": { "const": "normal" },
    "source": { "const": "qmi8658_i2c" },
    "source_status": { "const": "observed" },
    "fw_version": { "type": "string", "pattern": "^[A-Za-z0-9._+:-]{1,32}$" },
    "test_run_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,32}$" },
    "seq": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "transport_type": { "enum": ["lte", "wifi"] },
    "boot_count": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "contract_version": { "const": "egolink.imu_window.v1" },
    "window_id": {
      "type": "string",
      "pattern": "^imuw-[A-Za-z0-9._:-]{1,16}-b[1-9][0-9]{0,9}$",
      "maxLength": 33
    },
    "capture_cmd_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,16}$" },
    "chunk_index": { "type": "integer", "minimum": 0, "maximum": 9 },
    "chunk_count": { "const": 10 },
    "sample_start_index": { "type": "integer", "minimum": 0, "maximum": 90 },
    "sample_count": { "const": 10 },
    "total_sample_count": { "const": 100 },
    "requested_interval_us": { "const": 50000 },
    "sample_record_bytes": { "const": 28 },
    "sample_encoding": { "const": "offset_us+six_i32le+base64-v1" },
    "chunk_crc32": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
    "samples_b64": { "type": "string", "minLength": 376, "maxLength": 376 }
  }
}
