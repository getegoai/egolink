{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egolink.local/contracts/sensor_frame.schema.json",
  "title": "Ego Link Sensor Frame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "device_id",
    "timestamp_ms",
    "frame_id",
    "sources"
  ],
  "properties": {
    "contract_version": {
      "const": "safety-companion.contract.v0.1"
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "enum": [
          "motion",
          "audio",
          "location",
          "network",
          "device",
          "vision"
        ]
      },
      "uniqueItems": true
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "accel_window": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vector3"
          }
        },
        "gyro_window": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vector3"
          }
        },
        "stationary_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000
        },
        "window_ms": {
          "type": "integer",
          "minimum": 0
        },
        "event_scores": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fix": {
          "type": "boolean"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "speed_mps": {
          "type": "number",
          "minimum": 0
        },
        "accuracy_m": {
          "type": "number",
          "minimum": 0
        },
        "outside_safe_zone": {
          "type": "boolean"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registered": {
          "type": "boolean"
        },
        "link_type": {
          "type": "string"
        },
        "signal_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "battery_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "charging": {
          "type": "boolean"
        },
        "base_online": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    }
  }
}
