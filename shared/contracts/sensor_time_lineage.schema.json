{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego.local/contracts/sensor_time_lineage.schema.json",
  "title": "Ego Link Sensor Time Lineage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "observation_id",
    "device_id",
    "source",
    "stream_id",
    "sequence_id",
    "monotonic_clock_domain_id",
    "boot_count",
    "timestamp_monotonic_ns",
    "timestamp_utc",
    "source_timestamp",
    "receive_timestamp_utc",
    "ingest_timestamp_utc",
    "alignment",
    "lineage",
    "imu_sample_derivation"
  ],
  "properties": {
    "contract_version": {
      "const": "egolink.sensor_time_lineage.v0.1"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source": {
      "type": "string",
      "enum": [
        "gnss",
        "lte",
        "imu",
        "camera"
      ]
    },
    "stream_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "sequence_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "monotonic_clock_domain_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "boot_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "timestamp_monotonic_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "timestamp_utc": {
      "$ref": "#/$defs/nullableUtcTimestamp"
    },
    "source_timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_value",
        "unit",
        "clock_domain_id",
        "semantics",
        "source_field"
      ],
      "properties": {
        "raw_value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "ns",
            "us",
            "ms",
            "s",
            "iso8601",
            "gnss_date_time",
            "opaque",
            "unavailable"
          ]
        },
        "clock_domain_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "semantics": {
          "type": "string",
          "enum": [
            "sample_time",
            "measurement_time",
            "fix_time",
            "modem_event_time",
            "exposure_start",
            "exposure_center",
            "exposure_end",
            "capture_start",
            "message_time",
            "unknown"
          ]
        },
        "source_field": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "receive_timestamp_utc": {
      "$ref": "#/$defs/nullableUtcTimestamp"
    },
    "ingest_timestamp_utc": {
      "$ref": "#/$defs/nullableUtcTimestamp"
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "timestamp_monotonic_origin",
        "monotonic_source_field",
        "timestamp_utc_origin",
        "mapping_id",
        "anchor",
        "uncertainty_ns",
        "reason_codes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unavailable",
            "receive_only",
            "estimated",
            "verified"
          ]
        },
        "timestamp_monotonic_origin": {
          "type": "string",
          "enum": [
            "source_timestamp",
            "device_capture",
            "unavailable"
          ]
        },
        "monotonic_source_field": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "timestamp_utc_origin": {
          "type": "string",
          "enum": [
            "source_timestamp",
            "clock_mapping",
            "unavailable"
          ]
        },
        "mapping_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "anchor": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "anchor_id",
                "method",
                "evidence_ref",
                "evidence_sha256"
              ],
              "properties": {
                "anchor_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]{1,128}$"
                },
                "method": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.:-]{1,128}$"
                },
                "evidence_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                }
              }
            }
          ]
        },
        "uncertainty_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,96}$"
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_scope",
        "source_status",
        "field_session_id",
        "test_run_id",
        "firmware_version",
        "firmware_commit",
        "source_record_ref",
        "source_record_sha256"
      ],
      "properties": {
        "evidence_scope": {
          "type": "string",
          "enum": [
            "field_session",
            "bench",
            "synthetic_fixture",
            "replay",
            "unknown"
          ]
        },
        "source_status": {
          "type": "string",
          "enum": [
            "verified",
            "observed",
            "mock",
            "pc_side_verified",
            "unknown",
            "unverified"
          ]
        },
        "field_session_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "test_run_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "firmware_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "firmware_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "source_record_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "source_record_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "imu_sample_derivation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "window_id",
            "capture_start_uptime_us",
            "capture_end_uptime_us",
            "offset_us"
          ],
          "properties": {
            "method": {
              "const": "capture_start_uptime_us_plus_offset_us"
            },
            "window_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "capture_start_uptime_us": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "capture_end_uptime_us": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "offset_us": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "nullableUtcTimestamp": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+]00:00)$"
        }
      ]
    }
  }
}
