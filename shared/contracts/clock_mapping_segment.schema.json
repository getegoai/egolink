{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego.local/contracts/clock_mapping_segment.schema.json",
  "title": "Ego Link Monotonic-to-UTC Clock Mapping Segment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "mapping_id",
    "device_id",
    "monotonic_clock_domain_id",
    "boot_count",
    "monotonic_origin_ns",
    "utc_origin",
    "utc_rate_correction_ppm",
    "valid_from_monotonic_ns",
    "valid_through_monotonic_ns",
    "anchor_method",
    "anchors",
    "anchor_count",
    "fit_rms_error_ns",
    "fit_max_error_ns",
    "uncertainty_ns",
    "status",
    "created_at",
    "lineage"
  ],
  "properties": {
    "contract_version": {
      "const": "egolink.clock_mapping_segment.v0.1"
    },
    "mapping_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "monotonic_clock_domain_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "boot_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "monotonic_origin_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "utc_origin": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "utc_rate_correction_ppm": {
      "type": "number",
      "minimum": -100000,
      "maximum": 100000
    },
    "valid_from_monotonic_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "valid_through_monotonic_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "anchor_method": {
      "type": "string",
      "pattern": "^[a-z0-9_.:-]{1,128}$"
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "anchor_id",
          "source",
          "timestamp_monotonic_ns",
          "timestamp_utc",
          "uncertainty_ns",
          "source_record_ref",
          "source_record_sha256"
        ],
        "properties": {
          "anchor_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "source": {
            "type": "string",
            "enum": [
              "gnss",
              "lte",
              "imu",
              "camera",
              "host_clock",
              "external_reference"
            ]
          },
          "timestamp_monotonic_ns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "timestamp_utc": {
            "$ref": "#/$defs/utcTimestamp"
          },
          "uncertainty_ns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "source_record_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "source_record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "anchor_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "fit_rms_error_ns": {
      "type": "number",
      "minimum": 0
    },
    "fit_max_error_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "uncertainty_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "status": {
      "type": "string",
      "enum": [
        "estimated",
        "verified"
      ]
    },
    "created_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_scope",
        "source_status",
        "field_session_id",
        "firmware_commit"
      ],
      "properties": {
        "evidence_scope": {
          "type": "string",
          "enum": [
            "field_session",
            "bench",
            "synthetic_fixture",
            "replay",
            "unknown"
          ]
        },
        "source_status": {
          "type": "string",
          "enum": [
            "verified",
            "observed",
            "mock",
            "pc_side_verified",
            "unknown",
            "unverified"
          ]
        },
        "field_session_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "firmware_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        }
      }
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+]00:00)$"
    }
  }
}
