{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego.local/contracts/imu_window_manifest.schema.json",
  "title": "EgoLink bounded IMU window manifest v1 normalized wire object",
  "description": "The complete EGLK/1 KV payload after underscore key normalization and scalar typing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "priority",
    "source",
    "source_status",
    "fw_version",
    "test_run_id",
    "seq",
    "transport_type",
    "boot_count",
    "contract_version",
    "window_id",
    "capture_cmd_id",
    "sample_count",
    "requested_interval_us",
    "capture_start_uptime_us",
    "capture_end_uptime_us",
    "min_interval_us",
    "mean_interval_us",
    "max_interval_us",
    "deadline_miss_count",
    "read_failure_count",
    "mock_sample_count",
    "warmup_sample_count",
    "warmup_interval_us",
    "chunk_count",
    "uploaded_chunk_count",
    "samples_crc32",
    "sensor_model",
    "sensor_i2c_address",
    "accel_unit",
    "gyro_unit",
    "activity_label",
    "label_source",
    "collection_authorization",
    "training_allowed",
    "mounting_profile_id",
    "axis_mapping_status",
    "calibration_profile_id"
  ],
  "properties": {
    "event_type": { "const": "imu_window_manifest" },
    "priority": { "const": "normal" },
    "source": { "const": "qmi8658_i2c" },
    "source_status": { "const": "observed" },
    "fw_version": { "type": "string", "pattern": "^[A-Za-z0-9._+:-]{1,32}$" },
    "test_run_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,32}$" },
    "seq": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "transport_type": { "enum": ["lte", "wifi"] },
    "boot_count": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "contract_version": { "const": "egolink.imu_window.v1" },
    "window_id": {
      "type": "string",
      "pattern": "^imuw-[A-Za-z0-9._:-]{1,16}-b[1-9][0-9]{0,9}$",
      "maxLength": 33
    },
    "capture_cmd_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,16}$" },
    "sample_count": { "const": 100 },
    "requested_interval_us": { "const": 50000 },
    "capture_start_uptime_us": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "capture_end_uptime_us": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "min_interval_us": { "type": "integer", "minimum": 1 },
    "mean_interval_us": { "type": "integer", "minimum": 1 },
    "max_interval_us": { "type": "integer", "minimum": 1 },
    "deadline_miss_count": { "type": "integer", "minimum": 0, "maximum": 100 },
    "read_failure_count": { "const": 0 },
    "mock_sample_count": { "const": 0 },
    "warmup_sample_count": { "const": 10 },
    "warmup_interval_us": { "const": 50000 },
    "chunk_count": { "const": 10 },
    "uploaded_chunk_count": { "const": 10 },
    "samples_crc32": { "type": "string", "pattern": "^[0-9A-F]{8}$" },
    "sensor_model": { "const": "QMI8658A" },
    "sensor_i2c_address": { "const": 106 },
    "accel_unit": { "const": "mg" },
    "gyro_unit": { "const": "mdps" },
    "activity_label": { "const": "unknown" },
    "label_source": { "const": "none" },
    "collection_authorization": { "const": "operator_command" },
    "training_allowed": { "const": false },
    "mounting_profile_id": { "const": "unrecorded" },
    "axis_mapping_status": { "const": "unrecorded" },
    "calibration_profile_id": { "const": "unrecorded" }
  }
}
