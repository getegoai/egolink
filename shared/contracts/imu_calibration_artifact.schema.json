{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego.local/contracts/imu_calibration_artifact.schema.json",
  "title": "EgoLink A0-001 engineering IMU calibration artifact v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calibration_id",
    "identity_sha256",
    "payload_sha256",
    "payload_hash_basis",
    "stage",
    "production_ready",
    "training_allowed",
    "calibration_run_id",
    "calibration_time_utc",
    "calibration_time_source",
    "device",
    "sensor",
    "mounting",
    "firmware",
    "software",
    "capture_profile",
    "source_exports",
    "source_windows",
    "accelerometer",
    "gyroscope",
    "availability",
    "quality",
    "materialized_output",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "egolink.imu_calibration_artifact.v0.1" },
    "calibration_id": { "type": "string", "pattern": "^imucal-[0-9a-f]{24}$" },
    "identity_sha256": { "$ref": "#/$defs/sha256" },
    "payload_sha256": { "$ref": "#/$defs/sha256" },
    "payload_hash_basis": { "const": "canonical_json_without_payload_sha256" },
    "stage": { "const": "engineering" },
    "production_ready": { "const": false },
    "training_allowed": { "const": false },
    "calibration_run_id": { "$ref": "#/$defs/safeId" },
    "calibration_time_utc": { "type": "string", "format": "date-time" },
    "calibration_time_source": { "enum": ["operator_provided_utc", "host_clock_utc"] },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "board_id", "hardware_revision", "hardware_profile"],
      "properties": {
        "device_id": { "$ref": "#/$defs/safeId" },
        "board_id": { "$ref": "#/$defs/safeId" },
        "hardware_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hardware_profile": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imu_model",
        "imu_module",
        "sensor_i2c_address",
        "source",
        "uncalibrated_accel_unit",
        "uncalibrated_gyro_unit"
      ],
      "properties": {
        "imu_model": { "type": "string", "minLength": 1, "maxLength": 64 },
        "imu_module": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sensor_i2c_address": { "type": "integer", "minimum": 0, "maximum": 127 },
        "source": { "const": "qmi8658_i2c" },
        "uncalibrated_accel_unit": { "const": "mg" },
        "uncalibrated_gyro_unit": { "const": "mdps" }
      }
    },
    "mounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mounting_profile_id", "calibration_frame", "body_axis_mapping_status"],
      "properties": {
        "mounting_profile_id": { "$ref": "#/$defs/safeId" },
        "calibration_frame": { "const": "sensor_axes" },
        "body_axis_mapping_status": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "firmware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fw_version", "firmware_commit", "firmware_image_sha256"],
      "properties": {
        "fw_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "firmware_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "firmware_image_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration_software_commit", "estimator_version"],
      "properties": {
        "calibration_software_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "estimator_version": { "const": "egolink.imu_six_face_calibration.v0.1" }
      }
    },
    "capture_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_contract_version",
        "test_run_id",
        "device_boot_counts",
        "sample_count_per_window",
        "requested_interval_us",
        "current_capture_rate_hz",
        "time_basis",
        "face_window_count",
        "gyro_window_count"
      ],
      "properties": {
        "source_contract_version": { "const": "egolink.imu_window.v1" },
        "test_run_id": { "$ref": "#/$defs/safeId" },
        "device_boot_counts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/bootCount" }
        },
        "sample_count_per_window": { "const": 100 },
        "requested_interval_us": { "const": 50000 },
        "current_capture_rate_hz": { "const": 20.0 },
        "time_basis": { "const": "device_monotonic_uptime_only" },
        "face_window_count": { "const": 6 },
        "gyro_window_count": { "const": 1 }
      }
    },
    "source_exports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256"],
        "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
      }
    },
    "source_windows": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/sourceWindow" }
    },
    "accelerometer": { "$ref": "#/$defs/accelerometer" },
    "gyroscope": { "$ref": "#/$defs/gyroscope" },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adc_counts", "temperature", "sample_utc"],
      "properties": {
        "adc_counts": { "const": "unavailable_in_imu_window_v1" },
        "temperature": { "const": "unavailable_in_imu_window_v1" },
        "sample_utc": { "const": "unavailable_pending_A0-002" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "all_source_hashes_verified",
        "all_windows_cadence_qualified",
        "all_windows_static",
        "all_face_labels_verified",
        "all_windows_gyro_consistent",
        "thresholds"
      ],
      "properties": {
        "passed": { "const": true },
        "all_source_hashes_verified": { "const": true },
        "all_windows_cadence_qualified": { "const": true },
        "all_windows_static": { "const": true },
        "all_face_labels_verified": { "const": true },
        "all_windows_gyro_consistent": { "const": true },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accel_norm_mean_mg",
            "max_accel_norm_stddev_mg",
            "min_face_dominant_mg",
            "max_face_off_axis_mean_mg",
            "max_static_gyro_mean_mdps",
            "max_static_gyro_stddev_mdps",
            "max_cross_window_gyro_delta_mdps",
            "sensitivity_mg_per_g",
            "max_accel_bias_mg",
            "max_primary_residual_mg",
            "max_off_axis_residual_mg"
          ],
          "properties": {
            "accel_norm_mean_mg": { "$ref": "#/$defs/pair" },
            "max_accel_norm_stddev_mg": { "type": "number", "minimum": 0 },
            "min_face_dominant_mg": { "type": "number", "minimum": 0 },
            "max_face_off_axis_mean_mg": { "type": "number", "minimum": 0 },
            "max_static_gyro_mean_mdps": { "type": "number", "minimum": 0 },
            "max_static_gyro_stddev_mdps": { "type": "number", "minimum": 0 },
            "max_cross_window_gyro_delta_mdps": { "type": "number", "minimum": 0 },
            "sensitivity_mg_per_g": { "$ref": "#/$defs/pair" },
            "max_accel_bias_mg": { "type": "number", "minimum": 0 },
            "max_primary_residual_mg": { "type": "number", "minimum": 0 },
            "max_off_axis_residual_mg": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "materialized_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "window_count", "sample_count", "sha256"],
      "properties": {
        "schema_version": { "const": "egolink.imu_calibrated_window.v0.1" },
        "window_count": { "const": 7 },
        "sample_count": { "const": 700 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,96}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bootCount": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "triple": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "faceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_positive", "x_negative", "y_positive", "y_negative", "z_positive", "z_negative"],
      "properties": {
        "x_positive": { "$ref": "#/$defs/triple" },
        "x_negative": { "$ref": "#/$defs/triple" },
        "y_positive": { "$ref": "#/$defs/triple" },
        "y_negative": { "$ref": "#/$defs/triple" },
        "z_positive": { "$ref": "#/$defs/triple" },
        "z_negative": { "$ref": "#/$defs/triple" }
      }
    },
    "roleMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_positive",
        "x_negative",
        "y_positive",
        "y_negative",
        "z_positive",
        "z_negative",
        "gyro_stationary"
      ],
      "properties": {
        "x_positive": { "$ref": "#/$defs/triple" },
        "x_negative": { "$ref": "#/$defs/triple" },
        "y_positive": { "$ref": "#/$defs/triple" },
        "y_negative": { "$ref": "#/$defs/triple" },
        "z_positive": { "$ref": "#/$defs/triple" },
        "z_negative": { "$ref": "#/$defs/triple" },
        "gyro_stationary": { "$ref": "#/$defs/triple" }
      }
    },
    "sourceWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "window_id",
        "capture_cmd_id",
        "boot_count",
        "test_run_id",
        "transport_type",
        "samples_sha256",
        "source_export_sha256",
        "sample_count"
      ],
      "properties": {
        "role": {
          "enum": ["x_positive", "x_negative", "y_positive", "y_negative", "z_positive", "z_negative", "gyro_stationary"]
        },
        "window_id": { "$ref": "#/$defs/safeId" },
        "capture_cmd_id": { "$ref": "#/$defs/safeId" },
        "boot_count": { "$ref": "#/$defs/bootCount" },
        "test_run_id": { "$ref": "#/$defs/safeId" },
        "transport_type": { "enum": ["lte", "wifi"] },
        "samples_sha256": { "$ref": "#/$defs/sha256" },
        "source_export_sha256": { "$ref": "#/$defs/sha256" },
        "sample_count": { "const": 100 }
      }
    },
    "accelerometer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "axis_order",
        "bias_mg_xyz",
        "sensitivity_mg_per_g_xyz",
        "correction_gain_xyz",
        "face_mean_mg",
        "calibrated_face_mean_mg",
        "residuals"
      ],
      "properties": {
        "method": { "const": "opposite_face_diagonal_bias_and_sensitivity_v0.1" },
        "axis_order": { "const": ["x", "y", "z"] },
        "bias_mg_xyz": { "$ref": "#/$defs/triple" },
        "sensitivity_mg_per_g_xyz": { "$ref": "#/$defs/triple" },
        "correction_gain_xyz": { "$ref": "#/$defs/triple" },
        "face_mean_mg": { "$ref": "#/$defs/faceMap" },
        "calibrated_face_mean_mg": { "$ref": "#/$defs/faceMap" },
        "residuals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_axis_mg", "off_axis_mg", "max_abs_primary_axis_mg", "max_abs_off_axis_mg"],
          "properties": {
            "primary_axis_mg": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x_positive", "x_negative", "y_positive", "y_negative", "z_positive", "z_negative"],
              "properties": {
                "x_positive": { "type": "number" },
                "x_negative": { "type": "number" },
                "y_positive": { "type": "number" },
                "y_negative": { "type": "number" },
                "z_positive": { "type": "number" },
                "z_negative": { "type": "number" }
              }
            },
            "off_axis_mg": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x_positive", "x_negative", "y_positive", "y_negative", "z_positive", "z_negative"],
              "properties": {
                "x_positive": { "$ref": "#/$defs/pair" },
                "x_negative": { "$ref": "#/$defs/pair" },
                "y_positive": { "$ref": "#/$defs/pair" },
                "y_negative": { "$ref": "#/$defs/pair" },
                "z_positive": { "$ref": "#/$defs/pair" },
                "z_negative": { "$ref": "#/$defs/pair" }
              }
            },
            "max_abs_primary_axis_mg": { "type": "number", "minimum": 0 },
            "max_abs_off_axis_mg": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "gyroscope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "axis_order",
        "bias_mdps_xyz",
        "stddev_mdps_xyz",
        "source_window_id",
        "sample_count",
        "window_mean_mdps",
        "max_abs_cross_window_delta_mdps"
      ],
      "properties": {
        "method": { "const": "signed_stationary_mean_bias_v0.1" },
        "axis_order": { "const": ["x", "y", "z"] },
        "bias_mdps_xyz": { "$ref": "#/$defs/triple" },
        "stddev_mdps_xyz": { "$ref": "#/$defs/triple" },
        "source_window_id": { "$ref": "#/$defs/safeId" },
        "sample_count": { "const": 100 },
        "window_mean_mdps": { "$ref": "#/$defs/roleMap" },
        "max_abs_cross_window_delta_mdps": { "type": "number", "minimum": 0 }
      }
    }
  }
}
