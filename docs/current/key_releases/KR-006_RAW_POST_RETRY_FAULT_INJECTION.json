    "egolink.p0.v1",
    "raw-frame.p0.v1"
  ],
  "device_id": "ego-link-r1-connectivity-001",
  "in_scope": [
    "LTE-008 fix1 bounded current-boot raw POST retry visibility",
    "LTE-009 Message Hub fail-once raw POST injection and retention",
    "LTE-009 default-off firmware fail-once test switch",
    "LTE-009 validator gate for command-scoped retained injected failure plus retry success",
    "VPS deployment and in-memory fail-once smoke without modifying GitLab",
    "ESP-IDF build evidence for the LTE-009 firmware image",
    "COM4 flash evidence for the LTE-009 image",
    "USB-Free LTE-009 request_location runtime evidence over SIM7670G LTE",
    "Released manifest and gate report for raw POST retry fault-injection"
  ],
  "non_claims": [
    "No product readiness claim",
    "No long LTE stability claim",
    "No reconnect recovery claim",
    "No durable offline cache or store-forward claim",
    "No multi-message outage recovery claim",
    "No GNSS fix or outdoor GNSS acceptance claim",
    "No battery accuracy, charging, or product power behavior claim",
    "No learned model, learned personal-place, route prediction, or positioning-accuracy claim",
    "No final enclosure, mounting, camera, audio, storage, calling, SMS, or dispatch claim"
  ],
  "gates": [
    {
      "id": "G1-LTE008-BOUNDED-RETRY-BASE",
      "status": "PASS",
      "summary": "LTE-008 fix1 provides the bounded current-boot raw POST retry helper and retry counter visibility used by LTE-009"
    },
    {
      "id": "G2-LTE009-FAIL-ONCE-RETENTION",
      "status": "PASS",
      "summary": "Message Hub retains the first marked raw frame as injected_failure, returns HTTP 503, suppresses derived telemetry for that attempt, and accepts the repeated raw frame"
    },
    {
      "id": "G3-LTE009-VPS-SMOKE",
      "status": "PASS",
      "summary": "VPS Message Hub deployment and in-memory fail-once smoke passed without modifying the existing GitLab service"
    },
    {
      "id": "G4-LTE009-BUILD-FLASH",
      "status": "PASS",
      "summary": "Guarded ESP-IDF build produced the LTE-009 binary and COM4 flash passed after explicit operator confirmation"
    },
    {
      "id": "G5-LTE009-USB-FREE-RUNTIME",
      "status": "PASS",
      "summary": "USB-Free runtime validation passed on independent power with USB disconnected, proving one injected first-POST failure followed by retry-derived location_report, location_observation, and ACK"
    },
    {
      "id": "G6-REGRESSION",
      "status": "PASS",
      "summary": "focused tests, validator tests, full verify, context_lint, key-release gate, and git diff checks passed"
    }
