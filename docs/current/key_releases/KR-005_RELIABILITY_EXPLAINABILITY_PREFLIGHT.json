    "LTE-005 offline reliability gate baseline",
    "OBS-004 reliability.network and reliability.cache observability surface",
    "LTE-006 fix1 firmware-side raw LTE location_observation network state fields",
    "LTE-006 explicit cache non-claim fields",
    "ESP-IDF build evidence for the LTE-006 fix1 firmware image",
    "USB-Free LTE-006 fix1 request_location runtime evidence",
    "LTE-005 reliability gate report over the LTE-006 fix1 runtime export",
    "Released manifest and gate report for reliability explainability"
  ],
  "non_claims": [
    "No product readiness claim",
    "No long LTE stability claim",
    "No reconnect recovery claim",
    "No durable offline cache or store-forward claim",
    "No cache/drop-message reliability claim",
    "No GNSS fix or outdoor GNSS acceptance claim",
    "No battery accuracy, charging, or product power behavior claim",
    "No learned model, learned personal-place, route prediction, or positioning-accuracy claim",
    "No final enclosure, mounting, camera, audio, storage, calling, SMS, or dispatch claim"
  ],
  "gates": [
