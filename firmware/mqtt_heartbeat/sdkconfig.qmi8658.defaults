CONFIG_IDF_TARGET="esp32s3"
# CONFIG_EGOLINK_PLATFORM_IMU_BACKEND_MOCK is not set
CONFIG_EGOLINK_PLATFORM_IMU_BACKEND_QMI8658=y
CONFIG_EGOLINK_DEVICE_ID="ego-link-amoled-qmi8658"
CONFIG_EGOLINK_STATUS_TOPIC="ego/link/ego-link-amoled-qmi8658/status"
CONFIG_EGOLINK_EVENT_TOPIC="ego/link/ego-link-amoled-qmi8658/event"
CONFIG_EGOLINK_HEARTBEAT_INTERVAL_SEC=5
CONFIG_EGOLINK_SENSOR_EVENT_INTERVAL_SEC=5
CONFIG_EGOLINK_PLATFORM_IMU_BOOT_SAMPLE_COUNT=40
CONFIG_EGOLINK_PLATFORM_IMU_BOOT_SAMPLE_INTERVAL_MS=50
