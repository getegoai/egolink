menu "Ego Link SIM7670G GNSS"

config EGOLINK_SIM7670_GNSS_ENABLED
    bool "Enable SIM7670G firmware GNSS AT query"
    default n
    depends on EGOLINK_MESSAGE_HUB_HTTP_ENABLED
    help
        Opt-in FW-002B path. When enabled, request_location queries the
        SIM7670G module through UART AT commands and reports a real module
        no-fix/fix state. It does not prove outdoor fix or LTE data transport.

config EGOLINK_SIM7670_LTE_STATUS_ENABLED
    bool "Enable SIM7670G LTE registration and cell state query"
    default n
    depends on EGOLINK_MESSAGE_HUB_HTTP_ENABLED
    help
        Opt-in LTE-001A observability path. When enabled, status and telemetry
        uploads include SIM, registration, PDP, APN, cell fingerprint, and
        signal state queried through SIM7670G UART AT commands. It does not
        route Message Hub HTTP traffic through LTE or prove LTE data transport.

config EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED
    bool "Enable SIM7670G LTE HTTP uplink probe"
    default n
    depends on EGOLINK_MESSAGE_HUB_HTTP_ENABLED && EGOLINK_SIM7670_LTE_STATUS_ENABLED
    help
        Opt-in LTE-002 path. When enabled, firmware skips Wi-Fi as the runtime
        data path and uses SIM7670G AT HTTP commands to POST a bounded
        lte_http_probe event to the Message Hub telemetry endpoint. This is a
        bounded LTE HTTP uplink slice only; command polling, ACK, reconnect,
        and long-run stability remain separate tasks.

config EGOLINK_SIM7670_UART_NUM
    int "SIM7670G UART number"
    default 1
    range 1 2
    depends on EGOLINK_SIM7670_GNSS_ENABLED || EGOLINK_SIM7670_LTE_STATUS_ENABLED || EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED

config EGOLINK_SIM7670_UART_RX_GPIO
    int "SIM7670G UART RX GPIO"
    default 17
    range 0 48
    depends on EGOLINK_SIM7670_GNSS_ENABLED || EGOLINK_SIM7670_LTE_STATUS_ENABLED || EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED
    help
        Official Waveshare ESP-IDF examples for ESP32-S3 + SIM7670X use
        ESP32-S3 RX GPIO17 connected to module TX.

config EGOLINK_SIM7670_UART_TX_GPIO
    int "SIM7670G UART TX GPIO"
    default 18
    range 0 48
    depends on EGOLINK_SIM7670_GNSS_ENABLED || EGOLINK_SIM7670_LTE_STATUS_ENABLED || EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED
    help
        Official Waveshare ESP-IDF examples for ESP32-S3 + SIM7670X use
        ESP32-S3 TX GPIO18 connected to module RX.

config EGOLINK_SIM7670_UART_BAUD
    int "SIM7670G UART baud"
    default 115200
    depends on EGOLINK_SIM7670_GNSS_ENABLED || EGOLINK_SIM7670_LTE_STATUS_ENABLED || EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED

config EGOLINK_SIM7670_AT_TIMEOUT_MS
    int "SIM7670G AT command timeout milliseconds"
    default 3000
    range 500 30000
    depends on EGOLINK_SIM7670_GNSS_ENABLED || EGOLINK_SIM7670_LTE_STATUS_ENABLED || EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED

config EGOLINK_SIM7670_LTE_HTTP_ACTION_TIMEOUT_MS
    int "SIM7670G HTTPACTION timeout milliseconds"
    default 30000
    range 5000 120000
    depends on EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED

config EGOLINK_SIM7670_LTE_HTTP_SET_CID_PARAM
    bool "Send AT+HTTPPARA CID before SIM7670G HTTP action"
    default n
    depends on EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED
    help
        Some SIMCom HTTP examples for older modules set HTTPPARA CID manually,
        while the A7600/A7670-style HTTP flow activates PDP during HTTPINIT and
        does not require it. Keep this disabled for the SIM7670G thin slice
        unless hardware evidence shows this module accepts and needs it.

config EGOLINK_SIM7670_LTE_HTTP_READY_WAIT_SEC
    int "SIM7670G LTE HTTP probe readiness wait seconds"
    default 120
    range 0 600
    depends on EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED
    help
        Maximum time LTE-002 waits for the SIM7670G status query to report
        LTE_READY before attempting HTTP. A value of 0 attempts immediately.

config EGOLINK_SIM7670_LTE_HTTP_READY_POLL_SEC
    int "SIM7670G LTE HTTP probe readiness poll seconds"
    default 5
    range 1 60
    depends on EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED

config EGOLINK_SIM7670_LTE_HTTP_PROBE_MAX_ATTEMPTS
    int "SIM7670G LTE HTTP probe max attempts"
    default 6
    range 1 60
    depends on EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED
    help
        Maximum number of LTE HTTP probe rounds to attempt before the LTE-002
        slice gives up. Each round refreshes LTE readiness and then posts the
        attempt/result telemetry pair.

config EGOLINK_SIM7670_LTE_HTTP_PROBE_RETRY_INTERVAL_SEC
    int "SIM7670G LTE HTTP probe retry interval seconds"
    default 20
    range 0 600
    depends on EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED
    help
        Delay between failed LTE HTTP probe rounds. Keeping this bounded lets
        USB-Free validation observe retries without turning LTE-002 into a
        long-run reconnect supervisor.

config EGOLINK_SIM7670_GNSS_POWER_ON_BEFORE_QUERY
    bool "Send AT+CGNSSPWR=1 before GNSS query"
    default y
    depends on EGOLINK_SIM7670_GNSS_ENABLED

endmenu
