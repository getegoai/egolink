# Copy this file to an ignored local sdkconfig, for example:
#   sdkconfig.vps.local
#
# Never commit <operator-vps> direct addresses, bearer tokens, or private
# device IDs. Production-style ingress uses the exact public TLS host below.

CONFIG_EGOLINK_MESSAGE_HUB_HTTP_ENABLED=y
CONFIG_EGOLINK_MESSAGE_HUB_BASE_URL="https://ego.example.invalid"
CONFIG_EGOLINK_MESSAGE_HUB_EXPECTED_TLS_HOST="ego.example.invalid"
CONFIG_EGOLINK_MESSAGE_HUB_BEARER_TOKEN="<runtime-token>"
CONFIG_EGOLINK_DEVICE_ID="ego-link-r1-connectivity-001"
CONFIG_EGOLINK_FW_VERSION="0.1.0-fw001-http"
CONFIG_EGOLINK_TEST_RUN_ID="field-r1-<yyyymmdd>-001"
CONFIG_EGOLINK_HEARTBEAT_INTERVAL_SEC=10
CONFIG_EGOLINK_SENSOR_EVENT_INTERVAL_SEC=30
CONFIG_EGOLINK_MESSAGE_HUB_COMMAND_POLL_INTERVAL_SEC=10
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Optional FW-002B SIM7670G firmware GNSS AT query.
# Leave disabled unless the build is explicitly for SIM7670G GNSS bring-up.
# CONFIG_EGOLINK_SIM7670_GNSS_ENABLED is not set

# Optional LTE-001A SIM7670G LTE registration/cell observability.
# Leave disabled unless the build is explicitly for LTE state diagnosis.
# CONFIG_EGOLINK_SIM7670_LTE_STATUS_ENABLED is not set

# CONFIG_EGOLINK_SIM7670_UART_NUM=1
# CONFIG_EGOLINK_SIM7670_UART_RX_GPIO=17
# CONFIG_EGOLINK_SIM7670_UART_TX_GPIO=18
# CONFIG_EGOLINK_SIM7670_UART_BAUD=115200
