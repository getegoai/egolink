# Apply after sdkconfig.defaults and sdkconfig.collection.defaults. This is an
# opt-in no-flash build profile; it does not assert hardware coexistence.
CONFIG_EGOLINK_COLLECTION_CAMERA_PROFILE=y
CONFIG_EGOLINK_PLATFORM_CAMERA_ENABLED=y
# CONFIG_EGOLINK_PLATFORM_CAMERA_SHARED_I2C_VERIFIED is not set
CONFIG_SCCB_HARDWARE_I2C_DRIVER_LEGACY=y
# CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW is not set
CONFIG_SCCB_HARDWARE_I2C_PORT0=y
# CONFIG_SCCB_HARDWARE_I2C_PORT1 is not set
CONFIG_SCCB_CLK_FREQ=100000
# QVGA JPEG with one internal-DRAM framebuffer is intentional. Enabling
# ESP32-S3 PSRAM in IDF 5.4.2 disables hardware atomics and violates existing
# location/delivery lock-free guards.
# CONFIG_SPIRAM is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_camera_collection_16mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_camera_collection_16mb.csv"
CONFIG_EGOLINK_PHOTO_MEDIA_SLOT_BYTES=32768
CONFIG_EGOLINK_PHOTO_MEDIA_MAX_PAYLOAD_BYTES=28672
CONFIG_EGOLINK_PHOTO_MEDIA_MAX_COMMITTED_PHOTOS=288
CONFIG_EGOLINK_PHOTO_MEDIA_MAX_TOTAL_PAYLOAD_BYTES=8257536
