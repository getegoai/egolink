# Bounded real GNSS + Wi-Fi HTTPS engineering profile; no flash authority.
CONFIG_EGOLINK_MESSAGE_HUB_HTTP_ENABLED=y
CONFIG_EGOLINK_SIM7670_GNSS_ENABLED=y
CONFIG_EGOLINK_SIM7670_LTE_STATUS_ENABLED=y
CONFIG_EGOLINK_SIM7670_LOCATION_MODEM_OWNER_ENABLED=y
# CONFIG_EGOLINK_LOC021S_MODEM_OWNER_SMOKE_PROFILE is not set
CONFIG_EGOLINK_LOC021_LIVE_PROFILE=y
CONFIG_EGOLINK_FW_VERSION="0.1.0-loc021-live"
CONFIG_EGOLINK_MESSAGE_HUB_BASE_URL="https://ego.example.invalid"
CONFIG_EGOLINK_MESSAGE_HUB_EXPECTED_TLS_HOST="ego.example.invalid"
# Fit the complete Wi-Fi/TLS/Q path in the retained 1 MiB factory partition.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_loc021_live.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_loc021_live.csv"
# RUN002 reached the real initialization chain and hit StackOverflowHook with
# the legacy 3584-byte main stack. Keep this allocation local to the live entry.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The dedicated source performs no legacy transport, observation or IMU path.
# CONFIG_EGOLINK_GNSS_LOCATION_SCAFFOLD_ENABLED is not set
# CONFIG_EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED is not set
# CONFIG_EGOLINK_SIM7670_LTE_HTTP_COMMAND_LOOP_ENABLED is not set
# CONFIG_EGOLINK_SIM7670_LOCATION_OBSERVATION_ENABLED is not set
# CONFIG_EGOLINK_SIM7670_D1_PERIODIC_LOCATION_ENABLED is not set
# CONFIG_EGOLINK_LTE_WIFI_FAILOVER_ENABLED is not set
# CONFIG_EGOLINK_WIFI_IMU_WINDOW_COMMAND_ENABLED is not set
# CONFIG_EGOLINK_SIM7670_P0_DELIVERY_TEST_DRIVER_ENABLED is not set
