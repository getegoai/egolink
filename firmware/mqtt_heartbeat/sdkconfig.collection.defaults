CONFIG_EGOLINK_COLLECTION_PROFILE=y
# CONFIG_EGOLINK_LOC021_LIVE_PROFILE is not set
# CONFIG_EGOLINK_LOC021S_MODEM_OWNER_SMOKE_PROFILE is not set
CONFIG_EGOLINK_COLLECTION_RUN_SECONDS=300
CONFIG_EGOLINK_COLLECTION_GNSS_INTERVAL_MS=5000
CONFIG_EGOLINK_COLLECTION_NO_SIM=y
CONFIG_EGOLINK_FW_VERSION="0.1.0-collection-v1"
CONFIG_EGOLINK_MESSAGE_HUB_HTTP_ENABLED=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT=y
CONFIG_EGOLINK_SIM7670_GNSS_ENABLED=y
CONFIG_EGOLINK_SIM7670_LTE_STATUS_ENABLED=y
CONFIG_EGOLINK_SIM7670_LOCATION_MODEM_OWNER_ENABLED=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_collection.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_collection.csv"
# Reuse the evidenced external QMI8658 bus; no wearable rail switching.
# CONFIG_EGOLINK_PLATFORM_IMU_BACKEND_MOCK is not set
CONFIG_EGOLINK_PLATFORM_IMU_BACKEND_QMI8658=y
CONFIG_EGOLINK_PLATFORM_IMU_QMI8658_SDA_GPIO=15
CONFIG_EGOLINK_PLATFORM_IMU_QMI8658_SCL_GPIO=16
CONFIG_EGOLINK_PLATFORM_IMU_QMI8658_I2C_ADDR=106
CONFIG_EGOLINK_PLATFORM_IMU_QMI8658_I2C_TIMEOUT_MS=20
# CONFIG_EGOLINK_PLATFORM_IMU_QMI8658_AXP2101_RAILS is not set
# Gauge probe only on the same already-reviewed bus; unavailable on probe fail.
# CONFIG_EGOLINK_PLATFORM_POWER_BACKEND_MOCK is not set
CONFIG_EGOLINK_PLATFORM_POWER_BACKEND_MAX17048=y
CONFIG_EGOLINK_PLATFORM_POWER_MAX17048_SDA_GPIO=15
CONFIG_EGOLINK_PLATFORM_POWER_MAX17048_SCL_GPIO=16
CONFIG_EGOLINK_PLATFORM_POWER_MAX17048_I2C_TIMEOUT_MS=20
# CONFIG_EGOLINK_GNSS_LOCATION_SCAFFOLD_ENABLED is not set
# CONFIG_EGOLINK_SIM7670_LTE_HTTP_PROBE_ENABLED is not set
# CONFIG_EGOLINK_SIM7670_LTE_HTTP_COMMAND_LOOP_ENABLED is not set
# CONFIG_EGOLINK_SIM7670_LOCATION_OBSERVATION_ENABLED is not set
# CONFIG_EGOLINK_SIM7670_D1_PERIODIC_LOCATION_ENABLED is not set
# CONFIG_EGOLINK_LTE_WIFI_FAILOVER_ENABLED is not set
# CONFIG_EGOLINK_WIFI_IMU_WINDOW_COMMAND_ENABLED is not set
# CONFIG_EGOLINK_SIM7670_P0_DELIVERY_TEST_DRIVER_ENABLED is not set
