# CALL-020G link/map-only profile. It retains the operator API and complete
# D/E/F/G/Q implementation, but the inert app_main does not call it. This file
# does not
# authorize flashing, USB/audio access, task start, modem or network activity.
CONFIG_EGOLINK_AUDIO_LOOP_AUTORUN=n
CONFIG_EGOLINK_CALL020_MEDIA_ADAPTER_CORE=y
CONFIG_EGOLINK_CALL020_USB_SERIAL_JTAG_ENDPOINT=y
CONFIG_EGOLINK_CALL020_WEARABLE_COMPOSITION=y
CONFIG_EGOLINK_CALL020_OUTPUT_VOLUME=55
CONFIG_EGOLINK_CALL020_OPERATOR_RUNNER=y
CONFIG_EGOLINK_CALL020_DEVICE_CONTROL_RESPONDER=y

# The retained application byte stream remains the exclusive future owner.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_UART is not set
# CONFIG_ESP_CONSOLE_USB_CDC is not set
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# CALL-020G does not perform OTA, NVS writes, flash erase/write, or any other
# cache-off operation while a session is running. Move only IDF-selected
# non-ISR FreeRTOS/ring-buffer functions to flash; keep all ISR ring-buffer
# functions in internal RAM for the USB Serial/JTAG interrupt path.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
# CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH is not set

# There are intentionally no identity, relay or credential values here.
# One fresh 128-bit nonce is requested only by an explicit runtime call to
# call020_operator_runner_prepare(). Its ESP fill-random quality is unverified
# without RF entropy-source evidence; the correlated role IDs are non-secret
# routing labels, not authentication credentials.
# CALL-020Q is retained for offline link review only. The boot stub is inert;
# no responder context is instantiated and no driver/control/media API runs.
